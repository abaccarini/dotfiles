set window-title-basename "true"
set selection-clipboard "clipboard"

# Dracula color theme for Zathura
# Swaps Foreground for Background to get a light version if the user prefers

#
# Dracula color theme
#

set notification-error-bg       rgba(255,85,85,1)     # Red
set notification-error-fg       rgba(248,248,242,1)   # Foreground
set notification-warning-bg     rgba(255,184,108,1)   # Orange
set notification-warning-fg     rgba(68,71,90,1)      # Selection
set notification-bg             rgba(14,13,17,1)      # Background
set notification-fg             rgba(248,248,242,1)   # Foreground

set completion-bg               rgba(14,13,17,1)      # Background
set completion-fg               rgba(98,114,164,1)    # Comment
set completion-group-bg         rgba(14,13,17,1)      # Background
set completion-group-fg         rgba(98,114,164,1)    # Comment
set completion-highlight-bg     rgba(14,13,17,1)      # Selection
set completion-highlight-fg     rgba(248,248,242,1)   # Foreground

set index-bg                    rgba(14,13,17,1)      # Background
set index-fg                    rgba(248,248,242,1)   # Foreground
set index-active-bg             rgba(29,27,34,1)      # Current Line
set index-active-fg             rgba(248,248,242,1)   # Foreground

set inputbar-bg                 rgba(14,13,17,1)      # Background
set inputbar-fg                 rgba(248,248,242,1)   # Foreground
set statusbar-bg                rgba(14,13,17,1)      # Background
set statusbar-fg                rgba(248,248,242,1)   # Foreground

set highlight-color             rgba(255,184,108,0.5) # Orange
set highlight-active-color      rgba(255,121,198,0.5) # Pink

set default-bg                  rgba(14,13,17,1)   # Background
set default-fg                  rgba(248,248,242,1)   # Foreground

set render-loading              true
set render-loading-fg           rgba(14,13,17,1)      # Background
set render-loading-bg           rgba(248,248,242,1)   # Foreground

#
# Recolor mode settings
#

set recolor-lightcolor          rgba(14,13,17,1)      # Background
set recolor-darkcolor           rgba(248,248,242,1)   # Foreground

#
# Startup options
#
set adjust-open width
set recolor true


set font 'monospace normal 24'
set scroll-step 300
set selection-notification false
set sandbox none
set statusbar-h-padding 0
set statusbar-v-padding 0
set page-padding 1
set selection-clipboard clipboard
set window-height 1500
set window-width 2000
map u scroll half-up
map d scroll half-down
# map D toggle_page_mode
map r reload
map R rotate
map [fullscreen] K zoom in
map [fullscreen] J zoom out
map K zoom in
map J zoom out
map i recolor
map p print
map g goto top
# map [normal] <C-f> search forward
# map [normal] <C-S-f> search backward
map [normal] n search forward
map [normal] p search backward
map <C-f> focus_inputbar "/"
map <C-F> focus_inputbar "?"
# map <C-f> exec 'xdotool key slash' 
# map <C-S-f> search backward
# map <C-f> /

# map <C-o> exec "zathura $FILE"
map <Button4> jumplist backward
map <Button5> jumplist forward
